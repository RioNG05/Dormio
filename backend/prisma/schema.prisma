datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  LANDLORD
  TENANT
  STAFF
}

enum RoomStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  DEPOSITED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum ServiceUnit {
  KWH
  M3
  PERSON
  ROOM
  MONTH
}

enum DepositStatus {
  PENDING
  CONFIRMED
  REFUNDED
  FORFEITED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  VIETQR
  MOMO
}

model User {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name")
  email        String    @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(TENANT)
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  profile           TenantProfile?
  boardingHouses    BoardingHouse[]   @relation("LandlordHouses")
  landlordContracts Contract[]        @relation("LandlordContracts")
  tenantContracts   Contract[]        @relation("TenantContracts")
  deposits          Deposit[]
  complaints        Complaint[]
  savedListings     SavedListing[]
  staffShifts       StaffShift[]
  aiChatLogs        AiChatLog[]
  paymentTxCreated  PaymentTransaction[]

  @@map("users")
}

model TenantProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  identityCardNumber    String?   @unique @map("identity_card_number")
  issueDate             DateTime? @map("issue_date")
  issuePlace            String?   @map("issue_place")
  permanentAddress      String?   @map("permanent_address")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  gender                String?
  dateOfBirth           DateTime? @map("date_of_birth")
  createdAt             DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenants_profile")
}

model BoardingHouse {
  id          String   @id @default(uuid())
  landlordId  String   @map("landlord_id")
  name        String
  address     String
  city        String
  district    String
  ward        String
  totalFloors Int      @default(1) @map("total_floors")
  description String?
  rules       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  landlord          User               @relation("LandlordHouses", fields: [landlordId], references: [id], onDelete: Cascade)
  rooms             Room[]
  roomAssets        RoomAsset[]
  serviceConfigs    ServiceConfig[]
  contracts         Contract[]
  invoices          Invoice[]
  operatingExpenses OperatingExpense[]
  complaints        Complaint[]
  listings          Listing[]
  staffShifts       StaffShift[]

  @@map("boarding_houses")
}

model Room {
  id            String     @id @default(uuid())
  houseId       String     @map("house_id")
  code          String
  title         String
  floor         Int        @default(1)
  price         Decimal    @db.Decimal(12, 2)
  depositAmount Decimal    @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  areaSqm       Decimal    @map("area_sqm") @db.Decimal(6, 2)
  maxOccupants  Int        @default(2) @map("max_occupants")
  status        RoomStatus @default(AVAILABLE)
  facilities    String[]
  images        String[]
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  house      BoardingHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assets     RoomAsset[]
  contracts  Contract[]
  deposits   Deposit[]
  invoices   Invoice[]
  complaints Complaint[]
  listings   Listing[]

  @@unique([houseId, code])
  @@map("rooms")
}

model RoomAsset {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  houseId   String   @map("house_id")
  name      String
  assetCode String?  @map("asset_code")
  quantity  Int      @default(1)
  condition String?  @default("GOOD")
  value     Decimal? @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  room  Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  house BoardingHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("room_assets")
}

model ServiceConfig {
  id          String      @id @default(uuid())
  houseId     String      @map("house_id")
  name        String
  unit        ServiceUnit @default(MONTH)
  price       Decimal     @db.Decimal(12, 2)
  isMandatory Boolean     @default(true) @map("is_mandatory")
  createdAt   DateTime    @default(now()) @map("created_at")

  house BoardingHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("service_configs")
}

model Contract {
  id               String         @id @default(uuid())
  contractCode     String         @unique @map("contract_code")
  houseId          String         @map("house_id")
  roomId           String         @map("room_id")
  landlordId       String         @map("landlord_id")
  tenantId         String         @map("tenant_id")
  startDate        DateTime       @map("start_date")
  endDate          DateTime       @map("end_date")
  rentalPrice      Decimal        @map("rental_price") @db.Decimal(12, 2)
  depositAmount    Decimal        @map("deposit_amount") @db.Decimal(12, 2)
  billingCycleDay  Int?           @default(1) @map("billing_cycle_day")
  status           ContractStatus @default(ACTIVE)
  notes            String?
  fileUrl          String?        @map("file_url")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  house    BoardingHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  room     Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  landlord User          @relation("LandlordContracts", fields: [landlordId], references: [id], onDelete: Restrict)
  tenant   User          @relation("TenantContracts", fields: [tenantId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@map("contracts")
}

model Deposit {
  id             String        @id @default(uuid())
  roomId         String        @map("room_id")
  landlordId     String        @map("landlord_id")
  customerName   String        @map("customer_name")
  customerPhone  String        @map("customer_phone")
  amount         Decimal       @db.Decimal(12, 2)
  depositDate    DateTime      @default(now()) @map("deposit_date")
  expectedMoveIn DateTime      @map("expected_move_in")
  status         DepositStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  landlord User @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  @@map("deposits")
}

model Invoice {
  id               String        @id @default(uuid())
  invoiceCode      String        @unique @map("invoice_code")
  contractId       String        @map("contract_id")
  houseId          String        @map("house_id")
  roomId           String        @map("room_id")
  month            Int
  year             Int
  electricityStart Decimal?      @default(0) @map("electricity_start") @db.Decimal(10, 2)
  electricityEnd   Decimal?      @default(0) @map("electricity_end") @db.Decimal(10, 2)
  waterStart       Decimal?      @default(0) @map("water_start") @db.Decimal(10, 2)
  waterEnd         Decimal?      @default(0) @map("water_end") @db.Decimal(10, 2)
  roomAmount       Decimal       @map("room_amount") @db.Decimal(12, 2)
  electricityAmount Decimal?     @default(0) @map("electricity_amount") @db.Decimal(12, 2)
  waterAmount      Decimal?      @default(0) @map("water_amount") @db.Decimal(12, 2)
  serviceAmount    Decimal?      @default(0) @map("service_amount") @db.Decimal(12, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  paidAmount       Decimal?      @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status           InvoiceStatus @default(UNPAID)
  dueDate          DateTime      @map("due_date")
  paidAt           DateTime?     @map("paid_at")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  contract Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  house    BoardingHouse        @relation(fields: [houseId], references: [id], onDelete: Cascade)
  room     Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments PaymentTransaction[]

  @@unique([contractId, month, year])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String  @map("invoice_id")
  itemName  String  @map("item_name")
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity  Decimal @default(1) @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  invoiceId       String        @map("invoice_id")
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  transactionCode String?       @map("transaction_code")
  paidAt          DateTime      @default(now()) @map("paid_at")
  note            String?
  createdBy       String?       @map("created_by")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("payment_transactions")
}

model OperatingExpense {
  id              String   @id @default(uuid())
  houseId         String   @map("house_id")
  title           String
  category        String
  amount          Decimal  @db.Decimal(12, 2)
  expenseDate     DateTime @default(now()) @map("expense_date")
  note            String?
  receiptImageUrl String?  @map("receipt_image_url")
  createdAt       DateTime @default(now()) @map("created_at")

  house BoardingHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@map("operating_expenses")
}

model Complaint {
  id          String            @id @default(uuid())
  houseId     String            @map("house_id")
  roomId      String            @map("room_id")
  tenantId    String            @map("tenant_id")
  title       String
  description String
  images      String[]
  priority    ComplaintPriority @default(MEDIUM)
  status      ComplaintStatus   @default(PENDING)
  resolvedAt  DateTime?         @map("resolved_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  house  BoardingHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  room   Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant User          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("complaints")
}

model Listing {
  id          String   @id @default(uuid())
  houseId     String   @map("house_id")
  roomId      String?  @map("room_id")
  title       String
  description String
  rentalPrice Decimal  @map("rental_price") @db.Decimal(12, 2)
  deposit     Decimal  @db.Decimal(12, 2)
  images      String[]
  isPublished Boolean  @default(true) @map("is_published")
  viewsCount  Int      @default(0) @map("views_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  house        BoardingHouse  @relation(fields: [houseId], references: [id], onDelete: Cascade)
  room         Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  savedByUsers SavedListing[]

  @@map("listings")
}

model SavedListing {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("saved_listings")
}

model StaffShift {
  id        String   @id @default(uuid())
  houseId   String   @map("house_id")
  staffId   String   @map("staff_id")
  shiftName String   @map("shift_name")
  workDate  DateTime @map("work_date")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  house BoardingHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  staff User          @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_shifts")
}

model AiChatLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  prompt     String
  response   String
  tokensUsed Int      @default(0) @map("tokens_used")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_chat_logs")
}
