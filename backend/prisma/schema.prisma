// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  leasing_agent
  tenant
  employee
  landlord
  admin
}

enum UserStatus {
  active
  inactive
  banned
}

enum Gender {
  male
  female
}

enum BoardingHouseStatus {
  active
  inactive
  banned
}

enum RoomStatus {
  available
  deposited
  occupied
  maintainace
}

enum ContractStatus {
  draft
  active
  expired
  canceled
}

enum SubscriptionPackage {
  free
  plus
  pro
}

enum SubscriptionStatus {
  pending
  active
  expired
  canceled
}

enum BillingCycle {
  monthly
  yearly
}

enum ExpenseStatus {
  pending
  paid
  canceled
}

enum ServiceStatus {
  active
  inactive
}

enum DepositType {
  contract
  platform
}

enum DepositStatus {
  pending
  paid
  refund
  forfeited
}

enum PostStatus {
  draft
  posted
  hidden
}

enum SourceType {
  free_quote
  purchased
}

enum PostPurchaseStatus {
  pending
  paid
  canceled
  failed
}

enum InvoiceStatus {
  unpaid
  paid
  overdue
}

enum PaymentType {
  charge
  refund
}

enum PaymentMethod {
  cash
  banking
}

enum PaymentStatus {
  pending
  success
  failed
}

enum MessageAttachmentType {
  image
  file
}

enum AiMessageRole {
  user
  assistant
}

enum AuditLogAction {
  create
  update
  delete
  login
  payment
}

enum GrievencePriority {
  low
  medium
  high
}

enum GrievenceStatus {
  pending
  in_progress
  resolved
  rejected
}

enum AssignmentStatus {
  active
  inactive
}

enum ScheduleStatus {
  scheduled
  canceled
}

enum AttendanceStatus {
  not_yet
  on_time
  late
  absent
}

enum NotifyChannel {
  zalo
  sms
  email
}

enum NofifyTarget {
  all_users
  all_landlords
  all_staff
  all_admins
  specific_user
}

enum NotifyStatus {
  pending
  sent
  failed
  canceled
}

enum OtpPurpose {
  login_verifycation
  reset_password
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String?    @db.VarChar(255)
  phoneNumber        String     @unique @map("phone_number") @db.VarChar(20)
  email              String?    @unique @db.VarChar(255)
  hashedPassword     String     @map("hashed_password") @db.VarChar(255)
  bio                String?
  avatarUrl          String?    @map("avatar_url")
  role               UserRole   @default(leasing_agent)
  status             UserStatus @default(active)
  roomId             String?    @default(uuid()) @map("room_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime?  @updatedAt @map("updated_at")
  mustChangePassword Boolean    @default(true) @map("must_change_password")

  boardingHouses        BoardingHouse[]
  tenantContracts       TenantContract[]
  userIdentification    UserIdentification?
  userSubscriptions     UserSubscription[]
  deposits              Deposit[]
  posts                 Post[]
  payments              Payment[]
  postPurchases         PostPurchase[]
  savedPosts            SavedPost[]
  postReaches           PostReach[]
  aiConversations       AiConversation[]
  auditLogs             AuditLog[]
  sentNotifications     Notification[]        @relation("Sender")
  receivedNotifications Notification[]        @relation("Receiver")
  employee              Employee?
  attendances           Attendance[]
  recurrencePatterns    RecurrencePattern[]
  createdNotifications  MassNotificationJob[] @relation("CreateNotify")
  targetedNotifications MassNotificationJob[] @relation("TargetNotify")
  otpCodes              OtpCode[]
  grievanceSends        Grievance[]           @relation("GrievanceSender")
  grievanceResolves     Grievance[]           @relation("GrievanceResolver")

  @@map("users")
}

model UserIdentification {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  user                   User      @relation(fields: [userId], references: [id])
  identityNumber         String    @unique @db.VarChar(255)
  fullName               String    @map("full_name") @db.VarChar(255)
  dateOfBirth            DateTime  @map("date_of_birth")
  gender                 Gender
  nationnality           String    @db.VarChar(255)
  placeOfOrigin          Json      @map("place_of_origin")
  placeOfResidence       Json      @map("place_of_residence")
  issueDate              DateTime  @map("issue_date")
  expiryDate             DateTime  @map("expiry_date")
  personalIdentification String    @map("personal_identification") @db.Uuid
  note                   String
  cardFrontUrl           String    @map("card_front_url")
  cardBackUrl            String    @map("card_back_url")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime? @updatedAt @map("updated_at")

  @@map("user_identifications")
}

model BoardingHouse {
  id          String              @id @default(uuid()) @db.Uuid
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String              @map("owner_id") @db.Uuid
  name        String              @db.VarChar(255)
  description String?
  country     String              @db.VarChar(255)
  province    String              @db.VarChar(255)
  city        String              @db.VarChar(255)
  ward        String              @db.VarChar(255)
  district    String              @db.VarChar(255)
  street      String              @db.VarChar(255)
  houseNumber String              @map("house_number") @db.VarChar(255)
  status      BoardingHouseStatus @default(active)
  thumbnail   String?
  totalFloor  Int?                @map("total_floor")
  builtAt     DateTime            @map("built_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime?           @updatedAt @map("updated_at")
  deletedAt   DateTime            @map("deleted_at")

  roomTypes           RoomType[]
  rooms               Room[]
  expenses            Expense[]
  services            Service[]
  deposits            Deposit[]
  aiConversations     AiConversation[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  grievences          Grievance[]
  jobPositions        JobPosition[]
  employeeAssignments EmployeeAssignment[]
  shifts              Shift[]
  workSchedules       WorkSchedule[]
  recurrencePatterns  RecurrencePattern[]

  @@map("boarding_houses")
}

model Expense {
  id              String        @id @default(uuid()) @db.Uuid
  boardingHouseId String        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id])
  roomId          String?       @map("room_id") @db.Uuid
  room            Room?         @relation(fields: [roomId], references: [id])
  name            String        @db.VarChar(255)
  description     String?
  category        String
  status          ExpenseStatus @default(pending)
  amount          Decimal
  createdAt       DateTime      @default(now()) @map("created_at")
  paidAt          DateTime

  @@map("expenses")
}

model Service {
  id              String        @id @default(uuid()) @db.Uuid
  boardingHouseId String        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id])
  name            String        @db.VarChar(255)
  price           Decimal
  unit            String        @db.VarChar(255)
  autoApplied     Boolean       @default(true) @map("auto_applied")
  isMetered       Boolean       @default(false) @map("is_metered")
  status          ServiceStatus @default(active)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")

  meterReadings MeterReading[]
  roomServices  RoomService[]
  invoiceItems  InvoiceItem[]

  @@map("services")
}

model MeterReading {
  id           String   @id @default(uuid()) @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  service      Service  @relation(fields: [serviceId], references: [id])
  roomId       String   @map("room_id") @db.Uuid
  room         Room     @relation(fields: [roomId], references: [id])
  readingValue Decimal? @map("reading_value")
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")

  invoiceId String?  @map("invoice_id") @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([roomId, invoiceId])
  @@map("meter_readings")
}

model RoomService {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  room      Room     @relation(fields: [roomId], references: [id])
  serviceId String   @map("service_id") @db.Uuid
  service   Service  @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("room_services")
}

model RoomType {
  id              String        @id @default(uuid()) @db.Uuid
  boardingHouseId String        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)
  name            String        @db.VarChar(255)
  description     String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")

  rooms Room[]

  @@map("room_types")
}

model Room {
  id              String        @id @default(uuid()) @db.Uuid
  boardingHouseId String        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id], onDelete: Cascade)
  roomNumber      String        @map("room_number") @db.VarChar(255)
  roomTypeId      String        @map("room_type_id") @db.Uuid
  roomType        RoomType      @relation(fields: [roomTypeId], references: [id])
  area            Decimal?      @db.Decimal()
  floor           Int
  maxOccupants    Int?          @map("max_occupants")
  status          RoomStatus    @default(available)
  image_url       String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")

  contracts     Contract[]
  expenses      Expense[]
  meterReadings MeterReading[]
  roomServices  RoomService[]
  deposits      Deposit[]
  posts         Post[]
  invoices      Invoice[]
  grievences    Grievance[]

  @@map("rooms")
}

model Contract {
  id                 String         @id @default(uuid()) @db.Uuid
  roomId             String         @db.Uuid
  room               Room           @relation(fields: [roomId], references: [id])
  rentPrice          Decimal        @map("rent_price")
  monthlyPaymentDate Int            @map("monthly_payment_date")
  status             ContractStatus @default(active)
  startDate          DateTime       @map("start_date")
  endDate            DateTime       @map("end_date")
  note               String
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime?      @updatedAt @map("updated_at")

  tenantContracts   TenantContract[]
  contractDocuments ContractDocument[]
  deposit           Deposit?
  post              Post?
  invoices          Invoice[]

  @@map("contracts")
}

model ContractDocument {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id])
  url        String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("contract_documents")
}

model TenantContract {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     User     @relation(fields: [tenantId], references: [id])
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id])
  isPrimary  Boolean  @default(true) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("tenant_contracts")
}

model SubscriptionPlan {
  planName       SubscriptionPackage @unique @map("plan_name")
  dailyPostQuote Int                 @map("daily_post_quote")
  priceMonthly   Decimal             @map("price_monthly")
  priceYearly    Decimal             @map("price_yearly")
  maxRoom        Int                 @map("max_room")
  description    String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime?           @updatedAt @map("updated_at")

  userSubscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  user             User                @relation(fields: [userId], references: [id])
  planName         SubscriptionPackage @map("plan_name")
  subscriptionPlan SubscriptionPlan    @relation(fields: [planName], references: [planName])
  startDate        DateTime            @map("start_date")
  endDate          DateTime            @map("end_date")
  billingCycle     BillingCycle        @map("billing_cycle")
  price            Decimal
  status           SubscriptionStatus
  createdAt        DateTime            @default(now()) @map("created_at")
  payment          Payment?

  @@map("user_subscriptions")
}

model PostPurchase {
  id               String             @id @default(uuid()) @db.Uuid
  buyerId          String             @map("buyer_id") @db.Uuid
  buyer            User               @relation(fields: [buyerId], references: [id])
  quantityPurchase Int                @map("quantity_purchase")
  unitPrice        Decimal            @map("unit_price")
  totalAmount      Decimal            @map("total_amount")
  status           PostPurchaseStatus
  createdAt        DateTime           @default(now()) @map("created_at")
  activatedAt      DateTime

  posts   Post[]
  payment Payment?

  @@map("post_purchases")
}

model Post {
  id                 String        @id @default(uuid()) @db.Uuid
  postedBy           String        @map("posted_by") @db.Uuid
  postedByUser       User          @relation(fields: [postedBy], references: [id])
  roomId             String?       @map("room_id") @db.Uuid
  room               Room?         @relation(fields: [roomId], references: [id])
  title              String
  content            String
  depositAmount      Decimal       @map("deposti_amount")
  status             PostStatus
  sourceType         SourceType    @map("source_type")
  postPurchaseId     String?       @map("post_purchase_id") @db.Uuid
  postPurchase       PostPurchase? @relation(fields: [postPurchaseId], references: [id])
  resultedContractId String?       @unique @map("resulted_contract_id") @db.Uuid
  contract           Contract?     @relation(fields: [resultedContractId], references: [id])
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime?     @updatedAt @map("updated_at")
  deletedAt          DateTime      @map("deleted_at")

  deposit     Deposit?
  postImages  PostImage[]
  savedPosts  SavedPost[]
  postReaches PostReach[]

  @@map("posts")
}

model PostImage {
  id     String @id @default(uuid()) @db.Uuid
  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id])
  url    String
}

model SavedPost {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  post        Post     @relation(fields: [postId], references: [id])
  savedBy     String   @db.Uuid
  savedByUser User     @relation(fields: [savedBy], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
}

model PostReach {
  id           String   @id @default(uuid()) @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  post         Post     @relation(fields: [postId], references: [id])
  viewedBy     String   @map("viewed_by") @db.Uuid
  viewedByUser User     @relation(fields: [viewedBy], references: [id])
  viewedAt     DateTime @map("viewed_at")
}

model Deposit {
  id               String        @id @default(uuid()) @db.Uuid
  roomId           String        @map("room_id") @db.Uuid
  room             Room          @relation(fields: [roomId], references: [id])
  boardingHouseId  String        @map("boarding_house_id") @db.Uuid
  boardingHouse    BoardingHouse @relation(fields: [boardingHouseId], references: [id])
  contractId       String?       @unique @map("contract_id") @db.Uuid
  contract         Contract?     @relation(fields: [contractId], references: [id])
  postId           String?       @unique @map("post_id") @db.Uuid
  post             Post?         @relation(fields: [postId], references: [id])
  type             DepositType
  amount           Decimal
  status           DepositStatus
  recordedManually Boolean       @map("recored_manually")
  recordedBy       String?       @map("recored_by") @db.Uuid
  recordedByUser   User?         @relation(fields: [recordedBy], references: [id])
  note             String?
  createdAt        DateTime      @default(now()) @map("created_at")

  payment Payment?

  @@map("deposits")
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  roomId      String        @map("room_id") @db.Uuid
  room        Room          @relation(fields: [roomId], references: [id])
  contractId  String?       @map("contract_id") @db.Uuid
  contract    Contract?     @relation(fields: [contractId], references: [id])
  totalAmount Decimal       @map("total_amount")
  status      InvoiceStatus
  dueDate     DateTime      @map("due_date")
  createdAt   DateTime      @default(now()) @map("created_at")

  payment       Payment?
  invoiceItems  InvoiceItem[]
  meterReadings MeterReading[]

  @@map("invoice")
}

model InvoiceItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  serviceId String?  @map("service_id") @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id])
  quantity  Int
  unitPrice Decimal  @map("unit_price")
  amount    Int

  @@map("invoice_item")
}

model Payment {
  id              String            @id @default(uuid()) @db.Uuid
  refundPaymentId String?           @unique @map("payment_refund_id") @db.Uuid
  refundPayment   Payment?          @relation("RefundPayment", fields: [refundPaymentId], references: [id])
  originalPayment Payment[]         @relation("RefundPayment")
  depositId       String?           @unique @map("deposit_id") @db.Uuid
  deposit         Deposit?          @relation(fields: [depositId], references: [id])
  postPurchaseId  String?           @unique @map("post_purchase_id") @db.Uuid
  postPurchase    PostPurchase?     @relation(fields: [postPurchaseId], references: [id])
  subscriptionId  String?           @unique @map("subscription_id") @db.Uuid
  subscription    UserSubscription? @relation(fields: [subscriptionId], references: [id])
  payerId         String?           @map("payer_id") @db.Uuid
  payer           User?             @relation(fields: [payerId], references: [id])
  invoiceId       String?           @unique @map("invoice_id") @db.Uuid
  invoice         Invoice?          @relation(fields: [invoiceId], references: [id])
  type            PaymentType
  amount          Decimal           @db.Decimal
  qrCodeUrl       String?           @map("qr_code_url")
  method          PaymentMethod
  status          PaymentStatus
  transactionRef  String?           @map("transaction_ref")
  receiptNumber   String?           @map("receipt_number") @db.VarChar(255)
  paidAt          DateTime          @map("paid_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime?         @updatedAt @map("updated_at")

  @@map("payments")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  user1Id   String    @map("user1_id") @db.Uuid
  user2Id   String    @map("user2_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  content        String
  isReacted      Boolean   @default(false)
  sentAt         DateTime  @map("sent_at")
  readAt         DateTime? @map("read_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id])
  attachments  MessageAttachment[]

  @@map("messages")
}

model MessageAttachment {
  id        String                @id @default(uuid()) @db.Uuid
  messageId String                @map("message_id") @db.Uuid
  type      MessageAttachmentType
  url       String
  sizeBytes Int                   @map("size_bytes")
  sortOrder Int                   @map("sort_order")

  message Message @relation(fields: [messageId], references: [id])

  @@map("message_attachments")
}

model AiMessage {
  id               String         @id @default(uuid()) @db.Uuid
  aiConversationId String         @map("ai_conversation_id") @db.Uuid
  aiConversation   AiConversation @relation(fields: [aiConversationId], references: [id])
  role             AiMessageRole
  content          String
  model            String
  tokenUsage       Int?           @map("token_usage")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("ai_messages")
}

model AiConversation {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id])
  boardingHouseId String        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  messages AiMessage[]

  @@map("ai_conversations")
}

model AuditLog {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String?        @map("user_id") @db.Uuid
  user            User?          @relation(fields: [userId], references: [id])
  boardingHouseId String?        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse? @relation(fields: [boardingHouseId], references: [id])
  action          AuditLogAction
  entityType      String         @map("entity_type")
  entityId        String         @map("entity_id") @db.Uuid
  oldValue        Json?          @map("old_value")
  newValue        Json?          @map("new_value")
  ipAddress       String         @map("ip_address")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Notification {
  id              String         @id @default(uuid()) @db.Uuid
  boardingHouseId String?        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse? @relation(fields: [boardingHouseId], references: [id])
  senderId        String         @map("sender_id") @db.Uuid
  sender          User           @relation("Sender", fields: [senderId], references: [id])
  receiverId      String?        @map("receiver_id") @db.Uuid
  receiver        User?          @relation("Receiver", fields: [receiverId], references: [id])
  content         String
  type            String
  isRead          Boolean        @map("is_read")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("notifications")
}

model GrievanceImage {
  id          String    @id @default(uuid()) @db.Uuid
  grievanceId String    @map("grievance_id") @db.Uuid
  grievance   Grievance @relation(fields: [grievanceId], references: [id])
  url         String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("grievance_images")
}

model Grievance {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  tenant          User              @relation("GrievanceSender", fields: [tenantId], references: [id])
  boardingHouseId String            @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse     @relation(fields: [boardingHouseId], references: [id])
  roomId          String            @map("room_id") @db.Uuid
  room            Room              @relation(fields: [roomId], references: [id])
  title           String
  description     String
  priority        GrievencePriority @default(medium)
  status          GrievenceStatus   @default(pending)
  resolvedBy      String?           @map("resolved_by") @db.Uuid
  resolvedByUser  User?             @relation("GrievanceResolver", fields: [resolvedBy], references: [id])
  resolutionNote  String?           @map("resolution_note")
  resolvedAt      DateTime?         @map("resolved_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime?         @updatedAt @map("updated_at")

  images GrievanceImage[]

  @@map("grievances")
}

model Employee {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  employeeAssignments EmployeeAssignment[]
  workSchedules       WorkSchedule[]
  recurrencePatterns  RecurrencePattern[]
  attendances         Attendance[]

  @@map("employees")
}

model JobPosition {
  id              String        @id @default(uuid()) @db.Uuid
  boardingHouseId String        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id])
  name            String        @db.VarChar(255)
  description     String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")

  employeeAssignments EmployeeAssignment[]

  @@map("job_positions")
}

model EmployeeAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  employee        Employee         @relation(fields: [employeeId], references: [id])
  positionId      String           @map("position_id") @db.Uuid
  position        JobPosition      @relation(fields: [positionId], references: [id])
  boardingHouseId String           @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse    @relation(fields: [boardingHouseId], references: [id])
  status          AssignmentStatus @default(active)
  joinedAt        DateTime         @map("joined_at")
  leftAt          DateTime         @map("left_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("employee_assignments")
}

model Shift {
  id              String        @id @default(uuid()) @db.Uuid
  boardingHouseId String        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id])
  name            String
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")

  workSchedules      WorkSchedule[]
  recurrencePatterns RecurrencePattern[]

  @@map("shifts")
}

model RecurrencePattern {
  id              String        @id @default(uuid()) @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  employee        Employee      @relation(fields: [employeeId], references: [id])
  boardingHouseId String        @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse @relation(fields: [boardingHouseId], references: [id])
  shiftId         String        @db.Uuid
  shift           Shift         @relation(fields: [shiftId], references: [id])
  daysOfWeek      String        @map("days_of_week") //e.g: '2,3,4'
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  createdBy       String        @db.Uuid
  createdByUser   User          @relation(fields: [createdBy], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")

  workSchedules WorkSchedule[]

  @@map("recurrence_patterns")
}

model WorkSchedule {
  id              String             @id @default(uuid()) @db.Uuid
  employeeId      String             @map("employee_id") @db.Uuid
  employee        Employee           @relation(fields: [employeeId], references: [id])
  boardingHouseId String             @map("boarding_house_id") @db.Uuid
  boardingHouse   BoardingHouse      @relation(fields: [boardingHouseId], references: [id])
  shiftId         String             @db.Uuid
  shift           Shift              @relation(fields: [shiftId], references: [id])
  workDate        DateTime           @map("work_date")
  recurrenceId    String?            @db.Uuid
  recurrence      RecurrencePattern? @relation(fields: [recurrenceId], references: [id])
  status          ScheduleStatus     @default(scheduled)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime?          @updatedAt @map("updated_at")
  attendances     Attendance[]

  @@map("work_schedules")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  workScheduleId String           @map("work_schedule_id") @db.Uuid
  workSchedule   WorkSchedule     @relation(fields: [workScheduleId], references: [id])
  employeeId     String           @map("employee_id") @db.Uuid
  employee       Employee         @relation(fields: [employeeId], references: [id])
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  status         AttendanceStatus @default(not_yet)
  editedBy       String?          @map("edited_by") @db.Uuid
  editedByUser   User?            @relation(fields: [editedBy], references: [id])
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime?        @updatedAt @map("updated_at")

  @@map("attendances")
}

model MassNotificationJob {
  id            String        @id @default(uuid()) @db.Uuid
  createdBy     String        @map("created_by") @db.Uuid
  channel       NotifyChannel
  createdByUser User          @relation("CreateNotify", fields: [createdBy], references: [id])
  targetType    NofifyTarget
  targetId      String?       @db.Uuid
  targetUser    User?         @relation("TargetNotify", fields: [targetId], references: [id])
  title         String
  content       String
  status        NotifyStatus  @default(pending)
  sentCount     Int           @default(0)
  failedCount   Int           @default(0)
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("mass_notification_jobs")
}

model OtpCode {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id])
  codeHash     String     @map("code_hash")
  purpose      OtpPurpose
  expiresAt    DateTime   @map("expires_at")
  verifiedAt   DateTime?  @map("verified_at")
  attemptCount Int        @default(0) @map("attempt_count")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("otp_codes")
}
