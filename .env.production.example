# ─── Docker Compose — Production Environment ─────────────────────────────────
# Copy this file to .env.production and fill in all values before deploying.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ──────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=dormio
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=dormio_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_password_here

# ─── Frontend URL (for CORS) ────────────────────────────────────────────────
FRONTEND_URL=https://dormio.site

# ─── Next.js Build-time Env (baked into frontend image) ─────────────────────
NEXT_PUBLIC_API_URL=https://api.dormio.site
NEXT_PUBLIC_API_PORT=
NEXT_PUBLIC_GA_ID=G-6XJ0C471QC

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_64
JWT_EXPIRES_IN=7d

# ─── Storage ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Platform ────────────────────────────────────────────────────────────────
PLATFORM_DEPOSIT_HOLD_DAYS=7

# ─── PayOS ───────────────────────────────────────────────────────────────────
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ─── AI ──────────────────────────────────────────────────────────────────────
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_IMAGE=gemini-3.5-flash-lite
AI_MODEL_TEXT=gemini-3.5-flash-lite

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

