{
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"install:all": "pnpm install && pnpm --filter api install && pnpm --filter web install",
		"install:api": "pnpm --filter api install",
		"install:web": "pnpm --filter web install",
		"dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
		"dev:api": "pnpm --filter api start:dev",
		"dev:web": "pnpm --filter web dev",
		"build": "pnpm build:api && pnpm build:web",
		"build:api": "pnpm --filter api build",
		"build:web": "pnpm --filter web build",
		"start:api": "pnpm --filter api start:prod",
		"start:web": "pnpm --filter web start",
		"test": "pnpm test:api",
		"test:api": "pnpm --filter api test",
		"test:api:cov": "pnpm --filter api test:cov",
		"test:api:e2e": "pnpm --filter api test:e2e",
		"lint": "pnpm lint:api && pnpm lint:web",
		"lint:api": "pnpm --filter api lint",
		"lint:web": "pnpm --filter web lint",
		"format": "prettier --write \"api/src/**/*.ts\" \"api/test/**/*.ts\" \"web/src/**/*.{ts,tsx,js,jsx}\"",
		"format:check": "prettier --check \"api/src/**/*.ts\" \"api/test/**/*.ts\" \"web/src/**/*.{ts,tsx,js,jsx}\"",
		"db:generate": "pnpm --filter api db:generate",
		"db:migrate": "pnpm --filter api db:migrate",
		"db:migrate:prod": "pnpm --filter api db:migrate:deploy",
		"db:push": "pnpm --filter api db:push",
		"db:seed": "pnpm --filter api seed",
		"db:studio": "pnpm --filter api db:studio",
		"db:reset": "pnpm --filter api db:reset",
		"seed": "pnpm --filter api seed",
		"seed:prod": "pnpm --filter api seed:prod",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:restart": "docker compose restart",
		"docker:logs": "docker compose logs -f",
		"docker:logs:db": "docker compose logs -f postgres",
		"docker:logs:redis": "docker compose logs -f redis",
		"docker:logs:api": "docker compose logs -f api",
		"docker:logs:web": "docker compose logs -f web",
		"docker:ps": "docker compose ps",
		"docker:clean": "docker compose down -v",
		"docker:db": "docker compose up -d postgres redis pgadmin",
		"docker:dev": "docker compose up --build",
		"docker:dev:d": "docker compose up -d --build",
		"deploy:api": "powershell -Command \"$env:DOCKER_DEFAULT_PLATFORM='linux/amd64'; docker compose -f docker-compose.prod.yml --env-file web/.env.production build --no-cache api; docker save -o dormio-api.tar dormio-api:prod\"",
		"deploy:web": "powershell -Command \"$env:DOCKER_DEFAULT_PLATFORM='linux/amd64'; docker compose -f docker-compose.prod.yml --env-file web/.env.production build --no-cache web; docker save -o dormio-web.tar dormio-web:prod\"",
		"deploy:all": "powershell -Command \"$env:DOCKER_DEFAULT_PLATFORM='linux/amd64'; docker compose -f docker-compose.prod.yml --env-file web/.env.production build --no-cache; docker save -o dormio-api.tar dormio-api:prod; docker save -o dormio-web.tar dormio-web:prod\"",
		"docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
		"docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
		"docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
		"docker:prod:ps": "docker compose -f docker-compose.prod.yml ps",
		"docker:prod:restart": "docker compose -f docker-compose.prod.yml --env-file .env.production restart"
	},
	"devDependencies": {
		"concurrently": "^9.0.0",
		"prettier": "^3.9.6"
	}
}
